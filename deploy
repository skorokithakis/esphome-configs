#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 2 ]; then
  echo "Usage: $0 <room> <config.yml> [esphome args...]" >&2
  echo "Available rooms: livingroom, office, bedroom" >&2
  exit 1
fi

room_raw="$1"
config_path="$2"
shift 2

case "$room_raw" in
  livingroom)
    room_slug="livingroom"
    room_title="Living Room"
    ;;
  office)
    room_slug="office"
    room_title="Office"
    ;;
  bedroom)
    room_slug="bedroom"
    room_title="Bedroom"
    ;;
  *)
    echo "Unknown room: $room_raw" >&2
    echo "Available rooms: livingroom, office, bedroom" >&2
    exit 1
    ;;
esac

# `--device OTA` skips the interactive port prompt and lets esphome find the board
# itself: MQTT IP discovery first, then the mDNS hostname, and MQTT for the log
# tail. Only added when the caller has not chosen a device, so a fresh board can
# still be flashed with `--device /dev/ttyACM0` without esphome trying the network
# first.
device_args=()
case " $* " in
  *" --device "*|*" --device="*) ;;
  *) device_args=(--device OTA) ;;
esac

esphome -s room_slug "$room_slug" -s room_title "$room_title" run "$config_path" "${device_args[@]}" "$@"
